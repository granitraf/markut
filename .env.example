# Copy to .env and fill in real values. .env is gitignored — never commit keys.
ANTHROPIC_API_KEY=sk-ant-...
FMP_API_KEY=your-fmp-key
# Supabase Postgres connection string (Project Settings -> Database -> Connection string, URI).
# Leave unset to log runs to the local SQLite file markut_runs.db instead.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Operator console password (HTTP Basic, any username). Unset locally = open.
# In production (Railway) the console is LOCKED until this is set.
CONSOLE_PASSWORD=choose-a-long-password
# Optional: pin the public page's featured tickers, in order (default: 5 most recent)
# FEATURED_TICKERS=NVDA,AVGO
